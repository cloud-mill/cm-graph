{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2022": true },
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results", "foo"],
  "overrides": [
    { "files": ["e2e/**"], "rules": { "react/rules-of-hooks": "off", "react-hooks/rules-of-hooks": "off" } }
  ],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "off",
    "react/hooks": "off",
    "react/preserve-manual-memoization": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off",
    "react/exhaustive-effect-dependencies": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 5 }],
    "vitest/valid-expect": "off",
    "vitest/no-conditional-expect": "off"
  }
}
